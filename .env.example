# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Na Vercel, a integração Neon KIDSCARD_CORE injeta KIDSCARD_CORE_DATABASE_URL.
KIDSCARD_CORE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
STORAGE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
KIDSCARD_CORE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Autenticação
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-um-segredo-longo-e-aleatorio"
APP_BASE_URL="http://localhost:3000"

# Habilite temporariamente para criar o primeiro administrador em /configurar-admin.
# Remova da Vercel assim que a conta administrativa for criada.
ADMIN_SETUP_TOKEN="gere-uma-chave-temporaria-com-32-ou-mais-caracteres"

# E-mail transacional (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="KidsCard <acesso@seudominio.com.br>"

# Usado apenas ao executar `npm run seed` localmente.
SEED_DEMO_PASSWORD="defina-uma-senha-local-com-12-ou-mais-caracteres"

# O webhook de sandbox só funciona quando este segredo está configurado.
# Envie a assinatura HMAC SHA-256 no header x-kidscard-signature.
PAYMENTS_SANDBOX_WEBHOOK_SECRET="gere-outro-segredo-longo-e-aleatorio"
