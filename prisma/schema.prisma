generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GUARDIAN
  DEPENDENT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum CardStatus {
  ACTIVE
  BLOCKED
  CANCELED
}

enum TransactionType {
  DEPOSIT
  TRANSFER_IN
  TRANSFER_OUT
  PURCHASE
  REFUND
  FEE
  ADJUSTMENT
}

enum PaymentProvider {
  SANDBOX
  PISMO
  DOCK
  FITS
  OTHER
}

enum ProviderSyncStatus {
  LOCAL_ONLY
  PENDING
  SYNCED
  FAILED
}

enum TransactionDetailStatus {
  UNAVAILABLE
  PENDING
  AVAILABLE
  REVIEW_REQUIRED
  FAILED
}

enum TransactionDetailSource {
  MERCHANT_INTEGRATION
  FISCAL_RECEIPT
  AI_ASSISTED
  MANUAL_REVIEW
  SANDBOX
}

enum ReceiptStatus {
  RECEIVED
  PROCESSING
  MATCHED
  REVIEW_REQUIRED
  FAILED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum WalletBucketType {
  PRIMARY
  PENSION
  ALLOWANCE
  CLEARING
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum OnboardingStatus {
  SUBMITTED
  KYC_PENDING
  APPROVED
  REJECTED
}

enum PasswordTokenPurpose {
  FIRST_ACCESS
  PASSWORD_RESET
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  cpf           String   @unique
  passwordHash  String
  role          UserRole @default(GUARDIAN)
  agency        String
  accountNumber String   @unique
  mustChangePassword Boolean  @default(true)
  passwordChangedAt DateTime?
  lastLoginAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  walletAccounts        WalletAccount[]
  dependents            Dependent[]             @relation("GuardianDependents")
  onboardingApplication OnboardingApplication?  @relation("ApprovedApplicationUser")
  reviewedApplications  OnboardingApplication[] @relation("ApplicationReviewer")
  passwordTokens        PasswordResetToken[]
  auditLogs             AuditLog[]               @relation("AuditActor")
}

model WalletAccount {
  id           String             @id @default(cuid())
  userId       String
  balanceCents Int                @default(0)
  status       AccountStatus      @default(ACTIVE)
  provider     PaymentProvider    @default(SANDBOX)
  externalId   String?
  syncStatus   ProviderSyncStatus @default(LOCAL_ONLY)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards        Card[]
  transactions Transaction[]
  dependents   Dependent[]
  transfers    Transfer[]
  buckets      WalletBucket[]
  journals     LedgerJournal[]

  @@unique([provider, externalId])
}

model Card {
  id                    String             @id @default(cuid())
  accountId             String
  spendingBucketId      String?
  holderName            String
  brand                 String             @default("Visa")
  last4                 String
  color                 String             @default("Midnight Blue")
  status                CardStatus         @default(ACTIVE)
  provider              PaymentProvider    @default(SANDBOX)
  externalId            String?
  syncStatus            ProviderSyncStatus @default(LOCAL_ONLY)
  providerUpdatedAt     DateTime?
  allowPhysicalPurchase Boolean            @default(true)
  allowOnlinePurchase   Boolean            @default(false)
  allowContactless      Boolean            @default(true)
  allowNotifications    Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  account        WalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  spendingBucket WalletBucket? @relation(fields: [spendingBucketId], references: [id], onDelete: SetNull)
  transactions   Transaction[]

  @@unique([provider, externalId])
}

model Transaction {
  id                String                  @id @default(cuid())
  accountId         String
  cardId            String?
  provider          PaymentProvider         @default(SANDBOX)
  externalId        String?
  authorizationCode String?
  type              TransactionType
  amountCents       Int
  description       String
  merchant          String?
  category          String?
  detailStatus      TransactionDetailStatus @default(UNAVAILABLE)
  occurredAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  account  WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card     Card?             @relation(fields: [cardId], references: [id], onDelete: SetNull)
  items    TransactionItem[]
  receipts Receipt[]

  @@unique([provider, externalId])
  @@index([accountId, occurredAt])
  @@index([cardId, occurredAt])
}

model TransactionItem {
  id                    String                  @id @default(cuid())
  transactionId         String
  name                  String
  ean                   String?
  quantity              Decimal                 @default(1) @db.Decimal(12, 3)
  unitPriceCents        Int
  totalAmountCents      Int
  source                TransactionDetailSource
  confidenceBasisPoints Int?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([ean])
}

model Receipt {
  id               String                  @id @default(cuid())
  transactionId    String?
  source           TransactionDetailSource
  status           ReceiptStatus           @default(RECEIVED)
  accessKey        String?                 @unique
  merchantTaxId    String?
  issuedAt         DateTime?
  totalAmountCents Int?
  storageKey       String?
  rawPayload       Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionId, status])
}

model ProviderEvent {
  id          String              @id @default(cuid())
  provider    PaymentProvider
  externalId  String
  type        String
  status      ProviderEventStatus @default(RECEIVED)
  payload     Json
  error       String?
  receivedAt  DateTime            @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([status, receivedAt])
}

model Dependent {
  id                String    @id @default(cuid())
  guardianId        String
  accountId         String
  name              String
  cpf               String?   @unique
  birthDate         DateTime?
  monthlyLimitCents Int       @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  guardian  User           @relation("GuardianDependents", fields: [guardianId], references: [id], onDelete: Cascade)
  account   WalletAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfers Transfer[]
  buckets   WalletBucket[]
}

model Transfer {
  id                  String   @id @default(cuid())
  fromAccountId       String
  dependentId         String
  sourceBucketId      String?
  destinationBucketId String?
  journalId           String?  @unique
  amountCents         Int
  note                String?
  createdAt           DateTime @default(now())

  fromAccount       WalletAccount  @relation(fields: [fromAccountId], references: [id], onDelete: Cascade)
  dependent         Dependent      @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  sourceBucket      WalletBucket?  @relation("TransferSource", fields: [sourceBucketId], references: [id], onDelete: SetNull)
  destinationBucket WalletBucket?  @relation("TransferDestination", fields: [destinationBucketId], references: [id], onDelete: SetNull)
  journal           LedgerJournal? @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@index([fromAccountId, createdAt])
  @@index([dependentId, createdAt])
}

model WalletBucket {
  id           String           @id @default(cuid())
  accountId    String
  dependentId  String?
  type         WalletBucketType
  name         String
  balanceCents Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  account           WalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dependent         Dependent?    @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  entries           LedgerEntry[]
  outgoingTransfers Transfer[]    @relation("TransferSource")
  incomingTransfers Transfer[]    @relation("TransferDestination")
  cards             Card[]

  @@unique([dependentId, type])
  @@index([accountId, type])
}

model LedgerJournal {
  id             String   @id @default(cuid())
  accountId      String
  idempotencyKey String   @unique
  referenceType  String
  description    String
  createdAt      DateTime @default(now())

  account  WalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries  LedgerEntry[]
  transfer Transfer?

  @@index([accountId, createdAt])
}

model LedgerEntry {
  id          String               @id @default(cuid())
  journalId   String
  bucketId    String
  direction   LedgerEntryDirection
  amountCents Int
  createdAt   DateTime             @default(now())

  journal LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  bucket  WalletBucket  @relation(fields: [bucketId], references: [id], onDelete: Restrict)

  @@index([journalId])
  @@index([bucketId, createdAt])
}

model OnboardingApplication {
  id                    String           @id @default(cuid())
  guardianName          String
  email                 String
  phone                 String
  city                  String
  state                 String
  intendedUse           String
  dependentCount        Int
  status                OnboardingStatus @default(SUBMITTED)
  consentVersion        String
  privacyConsentAt      DateTime
  termsConsentAt        DateTime
  guardianDeclarationAt DateTime
  reviewedAt            DateTime?
  reviewedById          String?
  rejectionReason       String?
  userId                String?          @unique
  invitationSentAt      DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  user       User? @relation("ApprovedApplicationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([reviewedById, reviewedAt])
}

model PasswordResetToken {
  id        String               @id @default(cuid())
  userId    String
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt, usedAt])
}

model EmailDelivery {
  id             String              @id @default(cuid())
  toEmail        String
  template       String
  status         EmailDeliveryStatus @default(PENDING)
  providerId     String?
  error          String?
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([toEmail, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  subjectType String
  subjectId   String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([subjectType, subjectId, createdAt])
}
